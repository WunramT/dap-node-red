{
  "name": "dap-node-red",
  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",

  "features": {
    // The local Node-RED editor runs as a container, started from inside this
    // one. Outside-of-docker shares the host daemon, so the bind mount in
    // compose/editor.yml resolves against the host filesystem — with
    // docker-in-docker it would resolve inside the dev container and mount an
    // empty directory over the app.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // Prove the container before handing it over: install, validate the registry,
  // run the suites. registry.json is deliberately not generated here — PyYAML
  // exists in this container, and that file is the transport copy for hosts
  // without it. A stale one in a working tree once shadowed the registry.
  "postCreateCommand": ".devcontainer/setup.sh",
  "waitFor": "postCreateCommand",

  // Runs on every attach, so a new terminal starts by saying what to type.
  "postAttachCommand": "python3 scripts/guide.py --list",

  "forwardPorts": [1880],
  "portsAttributes": {
    "1880": { "label": "Node-RED editor", "onAutoForward": "silent" }
  },

  "containerEnv": {
    // compose/editor.yml mounts ../apps/$APP relative to itself. Inside this
    // container that path is the workspace; the docker daemon on the host needs
    // the host path, which this supplies.
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
    // The socket here is the host's Docker, so the editor uses docker even on a
    // workstation whose own convention is podman.
    "CONTAINER_ENGINE": "docker"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.vscode-yaml",
        "eamodio.gitlens"
      ],
      "settings": {
        "yaml.schemas": {
          "./schemas/registry.schema.json": "registry.yml"
        },
        "files.associations": { "Jenkinsfile": "groovy" },
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },

  "remoteUser": "vscode"
}
