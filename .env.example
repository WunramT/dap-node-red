# =============================================================================
# IMPORTANT: Special instruction for local development
# =============================================================================
# ROOT_PATH=""
# For local development, set ROOT_PATH to an empty string ("") to ensure the app is served at the root path (http://localhost:3000/).
# For production deployment behind a reverse proxy, set ROOT_PATH to the subpath where the app is served (e.g. "/app/" if the app is served at http://example.com/app/).
#
# VITE_BASE_PATH="any-app"
# Set VITE_BASE_PATH to any value rather than an empty string (e.g. "project-name") to ensure the frontend assets are served correctly.
# 
# DATABASE_SCHEMA="public"
# Set the DATABASE_SCHEMA always to public, to ensure correct alembic autogenerate behavior.
# Its important to keep public during development, otherwise alembic will recreate objects that already exist.
# During the production deployment, the DATABASE_SCHEMA is set, so migrations will work like expected.
#
# Further instrcutions may follow...
#
# =============================================================================


# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=app_db
DATABASE_USER=dev_user
DATABASE_PASSWORD=dev_password

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
DEBUG=true
SECRET_KEY=your-secret-key-minimum-32-characters-long!

# =============================================================================
# ROOT PATH SETTINGS
# For deployment behind a reverse proxy, set ROOT_PATH to the subpath where the app is served
# (e.g. "/app/" if the app is served at http://example.com/app/)
# (e.g. "/test/app/" if the app is served at http://example.com/test/app/)
# =============================================================================
ROOT_PATH=""
# =============================================================================
MODE=development

# =============================================================================
# AUTHENTICATION PROVIDERS
# Use T (true) or F (false) for each flag.
# Multiple providers can be active simultaneously in production mode.
# =============================================================================

# Azure AD / Entra ID SSO
AUTH_PROVIDER_AZURE=F

# E-Mail + Password login against local database
AUTH_PROVIDER_LOCAL_DB=F

# Single master-password login (admin and/or user level)
AUTH_PROVIDER_MASTER_PW=F

# Passwordless access: every visitor automatically gets role "user".
# They can still log in via an active provider to obtain higher roles.
USER_PASSWORDLESS=F

# =============================================================================
# MASTER PASSWORD CREDENTIALS
# Required when AUTH_PROVIDER_MASTER_PW=T
# =============================================================================
# Password that grants the "admin" role (required)
MASTER_PASSWORD_ADMIN=your-admin-master-password-here

# Password that grants the "user" role (optional)
# If not set, no user-level master-password login is available.
MASTER_PASSWORD_USER=

# =============================================================================
# AZURE AD / ENTRA ID CONFIGURATION
# Required when AUTH_PROVIDER_AZURE=T
# =============================================================================
AZURE_CLIENT_ID={{AZURE_CLIENT_ID}}
AZURE_CLIENT_SECRET=your-azure-client-secret-here
AZURE_TENANT_ID={{AZURE_TENANT_ID}}

# Frontend Azure settings (same values as backend)
VITE_AZURE_CLIENT_ID={{AZURE_CLIENT_ID}}
VITE_AZURE_TENANT_ID={{AZURE_TENANT_ID}}

# =============================================================================
# SENTRY ERROR TRACKING
# =============================================================================
# Backend Sentry
SENTRY_DSN={{SENTRY_DSN}}
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Frontend Sentry
VITE_SENTRY_DSN={{SENTRY_DSN}}
VITE_SENTRY_ENVIRONMENT=development
VITE_APP_VERSION=1.0.0

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# SMTP CONFIGURATION (for email notifications)
# =============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@{{PROJECT_DOMAIN}}
SMTP_FROM_NAME=dapnodered System
SMTP_USE_TLS=true

# =============================================================================
# FRONTEND SPECIFIC
# =============================================================================
VITE_API_URL=http://localhost:8000/api
VITE_BASE_PATH=""

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================
# Development (default):
#   MODE=development
#
# Production – Azure SSO only:
#   MODE=production
#   AUTH_PROVIDER_AZURE=T
#   AZURE_CLIENT_ID=...
#   AZURE_TENANT_ID=...
#   AZURE_CLIENT_SECRET=...
#
# Production – Passwordless visitors + admin master-password:
#   MODE=production
#   AUTH_PROVIDER_MASTER_PW=T
#   USER_PASSWORDLESS=T
#   MASTER_PASSWORD_ADMIN=supergeheim123
#
# Production – All providers active:
#   MODE=production
#   AUTH_PROVIDER_AZURE=T
#   AUTH_PROVIDER_LOCAL_DB=T
#   AUTH_PROVIDER_MASTER_PW=T
#   USER_PASSWORDLESS=T
#   MASTER_PASSWORD_ADMIN=supergeheim123
#   MASTER_PASSWORD_USER=userpass456
