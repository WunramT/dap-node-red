{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "assignees": ["@J.Moehlenpage", "@T.Wunram"],
  "reviewers": ["@J.Moehlenpage", "@T.Wunram"],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "semanticCommits": "enabled",
  "commitMessagePrefix": "chore(deps):",
  "separateMajorMinor": true,
  "separateMinorPatch": false,
  "rangeStrategy": "bump",
  "automerge": false,
  "platformAutomerge": false,
  "ignoreTests": false,
  "ignorePaths": ["**/package-lock.json"],
  "packageRules": [
    {
      "description": "Palette modules per app — one PR per app, reviewed against that app's flows",
      "matchManagers": ["npm"],
      "matchFileNames": ["apps/**"],
      "groupName": "palette-{{packageFileDir}}",
      "commitMessageTopic": "palette modules"
    },
    {
      "description": "Node-RED base image — a major bump changes flow-format compatibility",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nodered/node-red", "**/node-red-**"],
      "separateMajorMinor": true,
      "commitMessageTopic": "Node-RED base image"
    },
    {
      "description": "Deployment script dependencies",
      "matchManagers": ["pip_requirements"],
      "matchFileNames": ["scripts/**"],
      "groupName": "script-dependencies",
      "commitMessageTopic": "script dependencies"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "commitMessageSuffix": "[security]"
  },
  "pip_requirements": {
    "fileMatch": ["(^|/)requirements\\.txt$"]
  },
  "docker": {
    "enabled": true,
    "fileMatch": [
      "(^|/)Dockerfile$",
      "(^|/)Dockerfile\\.[^/]*$",
      "(^|/)docker-compose[^/]*\\.ya?ml$"
    ]
  }
}
