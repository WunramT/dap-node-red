  {
    "id": "8e80904d07d04b3f",
    "type": "function",
    "z": "71b64f9e3094bcd5",
    "name": "File Validation",
    "finalize": "",
    "func": "// Save file in flow context\nif (msg.payload && msg.payload.length > 0) {\n    flow.set('leather_uploadedFile', msg.payload);\n    flow.set('leather_fileName', msg.file.name || 'uploaded.xlsx');\n    \n    // Validate file type\n    const fileName = msg.file.name || '';\n    const validExtensions = ['.xlsx', '.xls', '.XLSX'];\n    const isValid = validExtensions.some(ext => fileName.toLowerCase().endsWith(ext));\n    \n    if (isValid) {\n        msg.payload = `✅ Plik \"${fileName}\" został załadowany`;\n        msg.topic = 'file_ready';\n        return [msg, null];\n    } else {\n        msg.payload = `❌ Nieprawidłowy typ pliku. Dozwolone są tylko pliki .xlsx i .xls.`;\n        msg.topic = 'file_error';\n        return [null, msg];\n    }\n} else {\n    msg.payload = 'Nie wybrano pliku';\n    msg.topic = 'no_file';\n    return [null, msg];\n}",
    "initialize": "",
    "libs": [],
    "noerr": 0,
    "outputs": 2,
    "timeout": 0,
    "x": 380,
    "y": 180,
    "wires": [
