    "func": "/*\nConstant values:\n- All `Deliveries.type = \"incoming\"`\n- All `Tours.id = tour_number + \"_4000\"`\n\n---\n\n*/\n\nconst pages = msg.payload;\nconst rows = []\nconst schema = \"leather_receipt\";  // schema name\n\n// --- Collect affected pk-values ---\nconst tourIds = new Set();\nconst vbelnIds = new Set();\nconst deliveryIds = new Set();\nconst aufnrIds = new Set();\n\n\nlet queries = [];  // For SQL Queries\nlet tableData = [];  // For UI\n\n// --- Helpful functions ---\n\nfunction formatDateForTour(isoDateString) {\n    try {\n        const date = new Date(isoDateString);\n        const day = String(date.getDate()).padStart(2, '0');\n        const month = String(date.getMonth() + 1).padStart(2, '0');\n        const year = date.getFullYear();\n        return `${day}.${month}.${year}`;  // Format: DD.MM.YYYY\n    } catch (err) {\n        return null;\n    }\n}\n\nfunction toSqlDate(isoString) {\n    try {\n        return new Date(isoString).toISOString().split('T')[0];  // 'YYYY-MM-DD'\n    } catch (e) {\n        return null;\n    }\n}\n\nfunction hasError(val) {\n    if (typeof val !== 'string') return false;\n    return val.includes('#ERROR') || val.includes('#N/A');\n}\n\n/**\n * Validates and normalizes tour_number from Excel.\n * \n * @param {any} tourNumber - The raw tour_number value from Excel\n * @param {number} rowIndex - Row index for error reporting (1-based)\n * @returns {Object} - { success: boolean, value: number|null, error: string|null }\n * \n * Validation rules:\n * - If number or numeric string → parse and return as number\n * - If contains \"SHOP\" or \"shop\" → return 999999\n * - Otherwise → return error\n */\nfunction validateTourNumber(tourNumber, rowIndex) {\n    // Already a valid number\n    if (typeof tourNumber === 'number') {\n        return { success: true, value: tourNumber, error: null };\n    }\n    \n    // Handle string values\n    if (typeof tourNumber === 'string') {\n        // Try to parse as number\n        const parsed = parseInt(tourNumber, 10);\n        if (!isNaN(parsed)) {\n            return { success: true, value: parsed, error: null };\n        }\n        \n        // Check for \"SHOP\" keyword (case-insensitive)\n        if (tourNumber.toLowerCase().includes('shop')) {\n            return { success: true, value: 999999, error: null };\n        }\n    }\n    \n    // Invalid tour number - return error\n    return {\n        success: false,\n        value: null,\n        error: `❌ Error: Invalid tour_number in row ${rowIndex} (Tour: ${tourNumber})`\n    };\n}\n\n// The following for loop iterates over all pages and its rows.\n// It starts at page 0 (page 1) and row 1 (row 2 in excel)\nfor (let i = 0; i < pages.length; i++){\n    for (let a = 1; a < pages[i].length; a++)\n        rows.push(pages[i][a]);\n}\n\n// Iterate over the new created array with all rows\nfor (let i = 0; i < rows.length; i++) {\n    const row = rows[i];\n\n    const delivery_id = row[1];\n    const delivery_pos = row[2];\n    const vbeln_id = row[3];\n    const aufnr_name = row[5];\n    const tour_number = row[7];\n    const tour_date_raw = row[8];\n    const aufnr_id = row[10];\n\n    const requiredValues = [delivery_id, delivery_pos, vbeln_id, aufnr_name, tour_number, tour_date_raw, aufnr_id];\n\n    // Helper: treat null, undefined, empty string as empty\n    const isEmpty = v => v === null || v === undefined || (typeof v === 'string' && v.trim() === '');\n\n    // 1. Skip if ALL positions are empty\n    if (requiredValues.every(isEmpty)) {\n        continue; // go to next row\n    }\n\n    // 2. Error if SOME but not all are empty or faulty\n    if (requiredValues.some(isEmpty) || requiredValues.some(v => hasError(v))) {\n        node.warn(`Error: Incomplete or invalid data in Excel row ${i + 1}`);\n        return [\n            null,\n            { payload: [] },  // Reset the JOIN Node\n            { topic: 'error', payload: `❌ Error: Missing or invalid data in row ${i + 1} (Dostawa: ${delivery_id})` }\n        ];\n    }\n\n    // 3. Validate and normalize tour_number\n    const tourValidation = validateTourNumber(tour_number, i + 1);\n    if (!tourValidation.success) {\n        node.warn(tourValidation.error);\n        return [\n            null,\n            { payload: [] },  // Reset the JOIN Node\n            { topic: 'error', payload: tourValidation.error }\n        ];\n    }\n    const validated_tour_number = tourValidation.value;\n\n    // 4. Process as normal below\n    const tour_date_formatted = formatDateForTour(tour_date_raw);\n    const tour_date = toSqlDate(tour_date_raw);\n\n    // 1. Insert Tour\n    const tour_id = `${validated_tour_number}_${tour_date_formatted}_4000`;\n    if (!tourIds.has(tour_id)) {\n        queries.push(\n            `INSERT INTO ${schema}.tour (id, tour_number, mbdat, state) VALUES ('${tour_id}', ${validated_tour_number}, '${tour_date}', 'open') ON CONFLICT (id) DO UPDATE SET tour_number = EXCLUDED.tour_number, mbdat = EXCLUDED.mbdat, state = EXCLUDED.state;`\n        );\n        tourIds.add(tour_id);\n    }\n\n    // 2. Insert Vbeln\n    if (!vbelnIds.has(vbeln_id)) {\n        queries.push(\n            `INSERT INTO ${schema}.vbeln (id, name, tour_id, state) VALUES (${vbeln_id}, 'vbeln_${vbeln_id}', '${tour_id}', 'open') ` +\n            `ON CONFLICT (id) DO UPDATE SET name=EXCLUDED.name, tour_id=EXCLUDED.tour_id, state=EXCLUDED.state;`\n        );\n        vbelnIds.add(vbeln_id);\n    }\n\n    // 3. Insert Deliveries\n    if (!deliveryIds.has(delivery_id)) {\n        queries.push(\n            `INSERT INTO ${schema}.deliveries (id, state, type) VALUES (${delivery_id}, 'loaded', 'incoming') ` +\n            `ON CONFLICT (id) DO UPDATE SET state=EXCLUDED.state, type=EXCLUDED.type;`\n        );\n        deliveryIds.add(delivery_id);\n    }\n\n    // 4. Insert Aufnr\n    queries.push(\n        `INSERT INTO ${schema}.aufnr (id, name, delivery_id, delivery_pos, vbeln_id, state, created_at, updated_at) ` +\n        `VALUES (${aufnr_id}, '${aufnr_name}', ${delivery_id}, ${delivery_pos}, ${vbeln_id}, 'loaded', NOW(), NOW()) ` +\n        `ON CONFLICT (id) DO UPDATE SET ` +\n        `name=EXCLUDED.name, ` +\n        `delivery_id=EXCLUDED.delivery_id, ` +\n        `delivery_pos=EXCLUDED.delivery_pos, ` +\n        `vbeln_id=EXCLUDED.vbeln_id, ` +\n        `state=EXCLUDED.state, ` +\n        `updated_at=NOW();`\n    );\n    aufnrIds.add(aufnr_id);\n\n    // Add table data for UI\n    tableData.push({\n        delivery_id: delivery_id,\n        delivery_pos: delivery_pos,\n        ta: vbeln_id,\n        tour: validated_tour_number,\n        tour_date: tour_date,\n        production_order: aufnr_id,\n        production_order_name: aufnr_name\n    });\n}\n\nmsg.query = queries.join(\"\\n\")\n\n// Multi-output return\nif (queries.length > 0) {\n    node.send(\n        [\n            { query: queries.join(\"\\n\") },\n            null,\n            null\n        ]\n    );\n};\n\n// Send all the table data after successfull processing\nfor (let i = 0; i < tableData.length; i++) {\n    node.send(\n        [\n            null,\n            { payload: tableData[i] },\n            null\n        ]\n    );\n}\nnode.send(\n    [\n        null,\n        null,\n        { complete: true },\n    ]\n);\n\n// Reset the flow variables\nflow.set('leather_uploadedFile', null);\nflow.set('leather_fileName', null);",
    "initialize": "",
    "libs": [],
    "noerr": 0,
